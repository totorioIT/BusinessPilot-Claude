---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden – BusinessPilot" description="Diese Seite gibt es nicht." noindex>
  <section class="section section--dark">
    <div class="container" style="max-width:720px">
      <span class="eyebrow">404</span>
      <h1 class="h2">Diese Seite gibt es nicht.</h1>
      <p class="lead">Vielleicht hilft dir einer dieser Wege weiter.</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn btn--primary" href="/">Zur Startseite</a>
        <a class="btn btn--outline-light" href="/#branchen">Branchen ansehen</a>
      </div>
    </div>
  </section>
</Base>
