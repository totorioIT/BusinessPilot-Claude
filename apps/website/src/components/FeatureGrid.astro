---
import Icon from './Icon.astro';
import { features, type FeatureExample, type FeatureId } from '../data/features';
import { plans } from '../data/plans';

interface Props {
  id?: string;
  industryName?: string;
  examples?: Partial<Record<FeatureId, FeatureExample>>;
  light?: boolean;
}
const { id = 'funktionen', industryName, examples = {}, light = false } = Astro.props;
const count = features.length;
const lead = industryName
  ? `${count} Bausteine, die Kundenkommunikation und wiederkehrende Abläufe miteinander verbinden – hier am Beispiel ${industryName}.`
  : `${count} Bausteine, die Kundenkommunikation und wiederkehrende Abläufe miteinander verbinden.`;
const items = features.map((f) => ({ ...f, example: examples[f.id] ?? f.example }));
---
<section id={id} class:list={['section', { 'section--light': light }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Funktionen</span>
      <h2 id={`${id}-title`} class="h2">Was kann RufAnna eigentlich alles?</h2>
      <p class="lead">{lead}</p>
    </div>
    <ul class="feature-grid" role="list">
      {items.map((f) => {
        const panelId = `${id}-${f.id}-workflow`;
        const ex = f.example;
        return (
          <li class="feature-card card">
            <div class="feature-card__head">
              <span class="icon-tile"><Icon name={f.icon} /></span>
              <h3 class="feature-card__title">{f.title}</h3>
            </div>
            <p class="feature-card__desc">{f.description}</p>
            {f.legalNote && (
              <p class="feature-card__legal"><Icon name="shield" size={14} /> {f.legalNote}</p>
            )}
            <div class="quote-box feature-card__example">
              {ex.isQuote ? <q>{ex.text}</q> : <span>{ex.text}</span>}
              {ex.sample && <span class="example-label">Beispielwerte</span>}
            </div>
            {ex.integration && (
              <span class="integration-label"><Icon name="plug" /> {ex.integration}</span>
            )}
            <button class="feature-card__toggle" type="button" aria-expanded="false" aria-controls={panelId} data-accordion>
              So reagiert RufAnna <Icon name="arrowRight" size={16} />
            </button>
            <div id={panelId} class="feature-card__workflow" role="region" aria-label={`So reagiert RufAnna: ${f.title}`} hidden>
              <div class="feature-card__workflow-head">
                <span class="feature-card__workflow-title">So reagiert RufAnna</span>
                <button class="feature-card__close" type="button" aria-label="Ablauf schließen" data-accordion-close>
                  <Icon name="close" size={18} />
                </button>
              </div>
              <ol>
                {ex.steps.map((s) => (
                  <li><Icon name="check" size={14} /> {s}</li>
                ))}
              </ol>
              {ex.outcome && <p class="feature-card__outcome">{ex.outcome}</p>}
            </div>
          </li>
        );
      })}
    </ul>
    <div class="feature-cta">
        <div class="feature-cta__intro">
          <h3 class="feature-cta__title">{industryName ? 'Welche Bausteine brauchen Sie?' : 'Welche Bausteine brauchst du?'}</h3>
          <p>{industryName
            ? 'Die Pakete START, BUSINESS und AUTOPILOT bündeln die Bausteine passend zu Ihrem Betrieb. Jedes Paket enthält alles aus dem vorherigen.'
            : 'Die Pakete START, BUSINESS und AUTOPILOT bündeln die Bausteine passend zu deinem Betrieb. Jedes Paket enthält alles aus dem vorherigen.'}</p>
          <a class="btn btn--primary" href="/#preise">Pakete vergleichen <Icon name="arrowRight" size={18} /></a>
        </div>
        <ul class="feature-cta__plans" role="list">
          {plans.map((p) => (
            <li class:list={['feature-cta__plan', { 'feature-cta__plan--highlight': p.highlighted }]}>
              <span class="feature-cta__plan-name">{p.name}</span>
              <span class="feature-cta__plan-pos">{p.positioning}</span>
              <ul role="list">
                {p.features.map((name) => <li><Icon name="check" size={14} /> {name}</li>)}
              </ul>
            </li>
          ))}
        </ul>
    </div>
  </div>
</section>

<script>
  // Der Ablauf öffnet sich als Ebene innerhalb der Kachel, damit alle Kacheln gleich groß bleiben.
  document.querySelectorAll<HTMLButtonElement>('[data-accordion]').forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
    if (!panel) return;
    const close = panel.querySelector<HTMLButtonElement>('[data-accordion-close]');
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      (open ? close : btn)?.focus();
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    close?.addEventListener('click', () => setOpen(false));
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  });
</script>

<style>
  .feature-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 20px; }
  .feature-card { position: relative; padding: 24px; display: flex; flex-direction: column; gap: 14px; overflow: hidden; }
  .feature-card__head { display: flex; align-items: center; gap: 12px; }
  .feature-card__title { font-size: 1.1875rem; }
  .feature-card__desc { color: var(--text-muted); font-size: .9375rem; flex: 1 1 auto; }
  .feature-card__example { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; font-size: .9375rem; }
  .feature-card__example q { quotes: '„' '“'; }
  .feature-card .integration-label { align-self: flex-start; }
  .feature-card__toggle {
    display: inline-flex; align-items: center; gap: 6px; align-self: flex-start;
    background: none; border: 0; padding: 4px 0; cursor: pointer;
    color: var(--green-700); font-weight: 700; font-size: .9375rem;
  }
  .feature-card__toggle:hover { text-decoration: underline; text-underline-offset: 3px; }
  .feature-card__toggle :global(svg) { transition: transform .2s ease; }
  .feature-card__toggle[aria-expanded='true'] :global(svg) { transform: rotate(90deg); }
  .feature-card__workflow {
    position: absolute; inset: 0; z-index: 1; padding: 20px 24px; overflow-y: auto;
    background: var(--white); border-radius: inherit;
  }
  .feature-card__workflow-head {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding-bottom: 10px; margin-bottom: 6px; border-bottom: 1px solid var(--gray-200);
  }
  .feature-card__workflow-title { font-weight: 800; color: var(--green-700); }
  .feature-card__close {
    display: inline-grid; place-items: center; width: 36px; height: 36px; flex: none;
    background: var(--green-50); color: var(--green-700); border: 0; border-radius: 10px; cursor: pointer;
  }
  .feature-card__close:hover { background: var(--green-100); }
  .feature-card__workflow ol { list-style: none; display: grid; gap: 0; }
  .feature-card__workflow li {
    position: relative; display: flex; align-items: center; gap: 10px; padding: 7px 0 7px 2px;
    font-size: .9375rem; font-weight: 600;
  }
  .feature-card__workflow li :global(svg) {
    flex: none; width: 22px; height: 22px; padding: 4px; border-radius: 50%;
    background: var(--green-500); color: var(--navy-900);
  }
  .feature-card__workflow li:not(:last-child)::after {
    content: ''; position: absolute; left: 12px; top: 30px; height: 14px; border-left: 2px solid var(--green-100);
  }
  .feature-card__outcome { margin-top: 8px; font-weight: 700; color: var(--green-700); font-size: .9375rem; }
  .feature-card__legal {
    display: flex; align-items: flex-start; gap: 6px; margin-top: -6px;
    color: var(--text-muted); font-size: .8125rem; line-height: 1.4;
  }
  .feature-card__legal :global(svg) { flex: none; margin-top: 2px; color: var(--green-700); }
  /* Paket-Box unter den Kacheln */
  .feature-cta {
    margin-top: 20px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 28px; align-items: start;
    padding: 32px; border-radius: var(--radius-lg); color: var(--white); background: var(--navy-900);
  }
  .feature-cta__intro { display: flex; flex-direction: column; gap: 16px; }
  .feature-cta__title { font-size: 1.5rem; }
  .feature-cta__intro p { color: var(--text-on-dark-muted); }
  .feature-cta .btn { align-self: flex-start; }
  .feature-cta__plans { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .feature-cta__plan {
    display: flex; flex-direction: column; gap: 6px; padding: 18px;
    border: 1px solid rgba(255, 255, 255, .12); border-radius: var(--radius); background: rgba(255, 255, 255, .04);
  }
  .feature-cta__plan--highlight { border-color: var(--green-500); box-shadow: inset 0 0 0 1px var(--green-500); }
  .feature-cta__plan-name { font-size: .8125rem; font-weight: 800; letter-spacing: .08em; color: var(--green-500); }
  .feature-cta__plan-pos { font-weight: 700; line-height: 1.3; margin-bottom: 6px; }
  .feature-cta__plan ul { list-style: none; display: grid; gap: 6px; }
  .feature-cta__plan li { display: flex; align-items: flex-start; gap: 8px; font-size: .875rem; color: var(--text-on-dark-muted); }
  .feature-cta__plan li :global(svg) { flex: none; margin-top: 3px; color: var(--green-500); }
  @media (max-width: 1024px) {
    .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feature-cta { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .feature-grid { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; gap: 12px; }
    .feature-cta { margin-top: 12px; }
    .feature-card__workflow { position: static; inset: auto; padding: 0; overflow: visible; }
    .feature-card { padding: 20px; }
    .feature-cta { padding: 24px 20px; }
  }
</style>
