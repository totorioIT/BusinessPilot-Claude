{
  "name": "businesspilot",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @bp/api",
    "dev:dashboard": "npm run dev -w @bp/dashboard",
    "dev:website": "npm run dev -w @bp/website",
    "build": "npm run build -w @bp/api && npm run build -w @bp/dashboard && npm run build -w @bp/website",
    "test": "npm test -w @bp/api",
    "db:migrate": "npm run db:migrate -w @bp/api",
    "db:seed": "npm run db:seed -w @bp/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
